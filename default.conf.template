server {
    listen       80;
    server_name  localhost;

    root   /usr/share/nginx/html;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml application/manifest+json;

    # Hashed build output can be cached forever.
    location /static/ {
        add_header Cache-Control 'public, max-age=31536000, immutable';
        access_log off;
    }

    location /index.html {
        add_header Last-Modified $date_gmt;
        add_header Cache-Control 'no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0';
        if_modified_since off;
        expires off;
        etag off;
    }

    location /health {
      add_header 'Content-Type' 'application/json';
      return 200 '{"status":"OK", "version": "${APP_VERSION}", "sha": "${BUILD_SHA}"}';
    }

    # redirect server error pages to the static page /50x.html
    #
    error_page   500 502 503 504  /50x.html;

    location / {
      try_files $uri @rewrites;
    }

    location @rewrites {
      rewrite ^(.+)$ /index.html last;
    }
}
